# Copy to .env and fill in what you use. .env is ignored by git; values already set in the
# environment take precedence over this file.

# --- App build (build.sh / Gradle) ---
# The one computer allowed to control Just Play over the LAN: the remote API on port 8791 and
# the YouTube streamer it resolves links through. Must be an IP address. Blank ships with the
# remote API off; it can also be set later in Library settings.
JPLAY_CONTROLLER=

# --- remote/jplay CLI ---
# Default device `jplay` sends to (a phone or Android TV running Just Play). --host overrides.
JPLAY_TARGET=
# bgutil-ytdlp-pot-provider's server/build/main.js, needed only for YouTube links.
JPLAY_BGUTIL=
# Networks the YouTube streamer answers, as comma-separated CIDRs.
# Blank: loopback plus the private ranges 10/8, 172.16/12, 192.168/16 and fc00::/7.
JPLAY_STREAM_ALLOW=

# --- scripts/provision-phone.py (debug builds only) ---
JPLAY_PHONE_SERIAL=
JPLAY_NAS_HOST=
JPLAY_NAS_SHARE=
JPLAY_NAS_FOLDER=
# A Samba credentials file with username=, password= and optionally domain= lines.
JPLAY_NAS_CREDENTIALS=
